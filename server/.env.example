PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=use-a-unique-password-at-least-12-chars
ADMIN_NAME=Workspace Admin
ADMIN_ORGANIZATION=BrandGuard
DEFAULT_ORGANIZATION=BrandGuard

# Organization assigned to new self-registered Creator accounts.
REGISTRATION_ORGANIZATION=brandguard
